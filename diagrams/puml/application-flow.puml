@startuml
title Жизненный цикл приложения

skinparam shadowing false

start
:main создаёт game;
:game() пытается загрузить savegame.json;
if (Сохранение найдено и корректно?) then (да)
  :Восстановить player;
else (нет)
  :Создать игрока по умолчанию;
  :Сохранить начальное состояние;
endif
:Создать Monaco, Spa и Monza;

while (Денег больше нуля?) is (да)
  :Показать главное меню и статус;
  switch (Выбор игрока)
  case (Grand Prix)
    :Выбрать трассу;
    :Проверить деньги, топливо и модификацию;
    if (Можно начать?) then (да)
      :Провести заезд;
      :Сохранить прогресс;
    else (нет)
      :Показать причину отказа;
    endif
  case (Team Shop)
    :Покупка топлива или мода, продажа лута либо ремонт;
    :Сохранить при изменении;
  case (F1 Museum)
    :Просмотр коллекции или пожертвование уникального лута;
    :Выдать награду за 3, 6 или 9 экспонатов;
    :Сохранить при изменении;
  case (Exit)
    :Сохранить прогресс;
    stop
  endswitch
endwhile (нет)

:Показать Game over;
stop
@enduml
